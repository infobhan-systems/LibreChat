# Observability machine env for docker-compose.observability.yml.
# Copy to .env.observability on that host and fill in real values.
# Start with:
#   docker compose --env-file .env.observability -f docker-compose.observability.yml up -d
#
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / METRICS_SECRET must match the app machine .env.

#=======================#
# Langfuse web publish  #
#=======================#

# Browser login callback origin. TLS edge does not proxy Langfuse; use private URL or VPN.
# Local edge (optional public via app nginx): http://watch.localhost:3000
# App .env LANGFUSE_BASE_URL stays http://<this-host-private-ip>:3001 for traces.
LANGFUSE_STACK_NEXTAUTH_URL=http://watch.localhost:3000
LANGFUSE_WEB_BIND=0.0.0.0
LANGFUSE_WEB_PORT=3001

#=======================#
# Langfuse stack secrets#
#=======================#

LANGFUSE_STACK_POSTGRES_USER=langfuse
LANGFUSE_STACK_POSTGRES_PASSWORD=change-me-postgres
LANGFUSE_STACK_POSTGRES_DB=langfuse
LANGFUSE_STACK_SALT=change-me-salt-at-least-32-chars-long
LANGFUSE_STACK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_STACK_NEXTAUTH_SECRET=change-me-nextauth-secret
LANGFUSE_STACK_CLICKHOUSE_USER=clickhouse
LANGFUSE_STACK_CLICKHOUSE_PASSWORD=change-me-clickhouse
LANGFUSE_STACK_MINIO_USER=minio
LANGFUSE_STACK_MINIO_PASSWORD=change-me-minio-password
LANGFUSE_STACK_REDIS_AUTH=change-me-redis-auth

#=======================#
# Langfuse project init #
#=======================#

LANGFUSE_INIT_ORG_ID=infobhan-org
LANGFUSE_INIT_ORG_NAME=Infobhan
LANGFUSE_INIT_PROJECT_ID=infobhan-librechat
LANGFUSE_INIT_PROJECT_NAME=LibreChat
# Same values as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY on the app machine.
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=change-me-langfuse-user

#=======================#
# Prometheus scrape     #
#=======================#

# App machine host:port for LibreChat /metrics (private network).
METRICS_SCRAPE_TARGET=app-host:3080
# Same value as METRICS_SECRET on the app machine.
METRICS_SECRET=change-me-metrics-secret
# App machine GPU exporter (docker-compose.infobhan.yml nvidia_gpu_exporter).
NVIDIA_GPU_SCRAPE_TARGET=app-host:9835
# App machine Ollama model/VRAM exporter (docker-compose.infobhan.yml ollama-exporter).
OLLAMA_EXPORTER_SCRAPE_TARGET=app-host:11435
# App machine host CPU/RAM/disk/network (docker-compose.infobhan.yml node_exporter).
NODE_EXPORTER_SCRAPE_TARGET=app-host:9100

#=======================#
# Grafana               #
#=======================#

GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# Subpath /grafana/. Local edge via app nginx: http://watch.localhost:3000/grafana/
# TLS production: private URL e.g. http://127.0.0.1:3002/grafana/ (not on public edge).
GF_SERVER_ROOT_URL=http://watch.localhost:3000/grafana/
